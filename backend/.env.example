# MongoDB Configuration
MONGO_URL=mongodb://localhost:27017/finforesight

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3001

# API Gateway Configuration
GATEWAY_PORT=3000

# Service URLs (for gateway)
AUTH_SERVICE_URL=http://localhost:3001
TRANSACTION_SERVICE_URL=http://localhost:3002
ML_SERVICE_URL=http://localhost:3003
NOTIFICATION_SERVICE_URL=http://localhost:3004
ACCOUNT_SERVICE_URL=http://localhost:3005
BUDGET_SERVICE_URL=http://localhost:3006
GOAL_SERVICE_URL=http://localhost:3007
PYTHON_ML_SERVICE_URL=http://localhost:5000

# Service Ports (optional - defaults are used if not specified)
AUTH_SERVICE_PORT=3001
TRANSACTION_SERVICE_PORT=3002
ML_SERVICE_PORT=3003
NOTIFICATION_SERVICE_PORT=3004
ACCOUNT_SERVICE_PORT=3005
BUDGET_SERVICE_PORT=3006
GOAL_SERVICE_PORT=3007
